# Real Wi-Fi credentials, kept out of version control.
#
# Copy this file to target.secret.exs (gitignored) and fill in your own
# network. The file's last expression becomes the `networks` list passed to
# VintageNetWiFi's vintage_net_wifi config, so it can hold more than one
# entry.

[
  %{
    key_mgmt: :wpa_psk,
    ssid: "YOUR_SSID",
    psk: "YOUR_PASSWORD"
  }
]
